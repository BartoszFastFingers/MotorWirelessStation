#include "motor_encoder.h"

void motor_encoder_init(motor_encoder_t* encoder, TIM_HandleTypeDef* encoder_tim,
		 uint8_t _cpr, TIM_HandleTypeDef* gen_tim, uint8_t ts)
{
	encoder->encoder_timer = encoder_tim;
	encoder->last_value = 0;
	encoder->gen_tim = gen_tim;
	encoder->cpr = _cpr;
	HAL_TIM_Encoder_Start(encoder->encoder_timer, TIM_CHANNEL_ALL);
}


float motor_encoder_rpm_callback(motor_encoder_t* encoder, motor_controller_t* controller, float Ts)
{
    int16_t curr_value = __HAL_TIM_GET_COUNTER(encoder->encoder_timer);

    int16_t delta;
    if (curr_value >= encoder->last_value) {
        delta = curr_value - encoder->last_value;
    } else {
        delta = (int16_t)(curr_value + (0xFFFF - encoder->last_value) + 1);
    }

    encoder->last_value = curr_value;

    float revolutions = (float)delta / (encoder->cpr * 4);
    float RPM = (revolutions / Ts) * 60.0f;

    return RPM;
}
