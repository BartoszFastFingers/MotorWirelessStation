#ifndef CORE_INC_MOTOR_ENCODER_H_
#define CORE_INC_MOTOR_ENCODER_H_


// GENERAL LIBARIES
#include "tim.h"
#include "stm32f4xx_hal_tim.h"
#include "arm_math.h"


#include "motor_controller.h"

typedef struct
{
	arm_fir_instance_f32* filter;
	float32_t* input;
	float32_t* output;
	uint32_t block_size;
}motor_encoder_filter_t;

typedef struct
{
	TIM_HandleTypeDef* encoder_timer;
	int32_t last_value;
	uint8_t cpr;
	uint8_t gear_ratio;

	motor_encoder_filter_t filter;
	float32_t rpm;
}motor_encoder_t;

void motor_encoder_init(motor_encoder_t* encoder, TIM_HandleTypeDef* encoder_tim,
		 uint8_t gear_ratio, uint8_t _cpr);

float motor_encoder_rpm_callback(motor_encoder_t* encoder, uint16_t Ts_ms);

#endif /* CORE_INC_MOTOR_ENCODER_H_ */
