#include "motor_controller.h"

void motor_controller_init(motor_controller* controller,
		TIM_HandleTypeDef *htim, uint32_t Channel)
{
	controller->htim = htim;
	controller->Channel = Channel;
	controller->current_value = 0;
	HAL_TIM_PWM_Start(htim, Channel);
}

void motor_controller_set_value(motor_controller* controller, int8_t value)
{
	if(value < CONTROLLER_MIN_ROT_VALUE) {value = CONTROLLER_MIN_ROT_VALUE;}
	else if(value > CONTROLLER_MAX_ROT_VALUE) {value = CONTROLLER_MAX_ROT_VALUE;}

	controller->current_value = value;
	__HAL_TIM_SET_COMPARE(controller->htim, controller->Channel, controller->current_value);
}

void motor_controller_set_direction(motor_controller* controller, motor_direction direction)
{
	GPIO_PinState left = GPIO_PIN_RESET;
	GPIO_PinState right = GPIO_PIN_RESET;
	switch(direction)
	{
	case NONE:
		break;
	case RIGHT: right = GPIO_PIN_SET;
		break;
	case LEFT: left = GPIO_PIN_SET;
		break;
	}

	HAL_GPIO_WritePin(controller->motor_direction_right.GPIOx,
			controller->motor_direction_right.GPIO_PIN, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(controller->motor_direction_left.GPIOx,
			controller->motor_direction_left.GPIO_PIN, GPIO_PIN_SET);

}

