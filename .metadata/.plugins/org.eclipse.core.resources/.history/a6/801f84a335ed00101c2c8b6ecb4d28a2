#include "motor_controller.h"

void motor_controller_init(motor_controler* controler,
		TIM_HandleTypeDef *htim, uint32_t Channel)
{
	controler->htim = htim;
	controler->Channel = Channel;
	HAL_TIM_PWM_Start(htim, Channel);
}

