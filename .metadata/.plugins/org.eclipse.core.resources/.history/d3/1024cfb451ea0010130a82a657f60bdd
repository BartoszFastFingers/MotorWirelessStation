cmake_minimum_required(VERSION 3.22)

# ----------------------------------------
# Project and cross-compiler settings
# ----------------------------------------
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

# Cross compiler
set(CMAKE_C_COMPILER /usr/bin/arm-none-eabi-gcc)
set(CMAKE_CXX_COMPILER /usr/bin/arm-none-eabi-g++)
set(CMAKE_ASM_COMPILER /usr/bin/arm-none-eabi-gcc)

# C standard
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS ON)

# Build type
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE "Debug")
endif()

# Project name
project(EmbeddedMotorControl)
message("Build type: " ${CMAKE_BUILD_TYPE})

# Enable ASM language
enable_language(C ASM)

# ----------------------------------------
# Executable target
# ----------------------------------------
add_executable(${PROJECT_NAME})

# ----------------------------------------
# Include STM32CubeMX generated sources
# ----------------------------------------
add_subdirectory(cmake/stm32cubemx)

# ----------------------------------------
# Add user sources (your application code)
# ----------------------------------------
file(GLOB_RECURSE USER_SRC
    Src/*.c
    Src/*.cpp
)

target_sources(${PROJECT_NAME} PRIVATE ${USER_SRC})

# ----------------------------------------
# Include paths
# ----------------------------------------
target_include_directories(${PROJECT_NAME} PRIVATE
    Inc
    Middlewares/ST/STM32_WPAN
    Middlewares/ST/STM32_WPAN/ble/stack
    Drivers/STM32_WBxx_HAL_Driver/Inc
    Drivers/STM32_WBxx_HAL_Driver/Inc/Legacy
)

# ----------------------------------------
# Compiler definitions
# ----------------------------------------
target_compile_definitions(${PROJECT_NAME} PRIVATE
    USE_HAL_DRIVER
    STM32WBAxx
)

# ----------------------------------------
# Add BLE sources
# ----------------------------------------
file(GLOB_RECURSE BLE_SRC
    Middlewares/ST/STM32_WPAN/ble/stack/*.c
)

target_sources(${PROJECT_NAME} PRIVATE ${BLE_SRC})

# ----------------------------------------
# Link libraries
# ----------------------------------------
target_link_libraries(${PROJECT_NAME} PRIVATE
    stm32cubemx
    STM32_WPAN
)

# ----------------------------------------
# Linker options
# ----------------------------------------
target_link_options(${PROJECT_NAME} PRIVATE -z noexecstack)

# ----------------------------------------
# Remove default libob linkage (for C++ projects)
# ----------------------------------------
list(REMOVE_ITEM CMAKE_C_IMPLICIT_LINK_LIBRARIES ob)
